# Copy to .env (git-ignored) on each host and fill in. NEVER commit real keys: the repo is public.
ANTHROPIC_API_KEY=
# claude-haiku-5-5 or claude-sonnet-5-5 (pick from scripts/bench-director.ts results)
DIRECTOR_MODEL=claude-haiku-5-5
ELEVENLABS_API_KEY=
# Filled by scripts/voice-design.ts
ELEVENLABS_VOICE_ID=

# Cap attempted TTS input characters below the account's remaining credit allowance.
# Empty keeps the current setup. Use 0 for captions and recorded lines only.
ELEVENLABS_TTS_CHAR_BUDGET=
# Rotate the period only when intentionally starting a new allocation. Keep the DB across restarts.
ELEVENLABS_TTS_BUDGET_PERIOD=default
# Optional persistent DB path. Default is hive/out/tts-usage.sqlite.
# ELEVENLABS_TTS_BUDGET_DB=
# Startup TTS warmup consumes credits. Set to 1 only when you want it.
ASK_WARM_AUDIO=0
# Reactor (Visko Orbis) key, used by orbis-relay
REACTOR_API_KEY=
# Shared secret for the bus, glasses API and Beat Board (?token=...). Any long random string.
HIVE_TOKEN=
PORT=8240
ORBIS_RELAY_URL=http://127.0.0.1:8241
# Public base URL of THIS host (used to build audio_url for the glasses)
PUBLIC_BASE_URL=https://beeswax.drori.dev
