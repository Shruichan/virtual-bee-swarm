{
  "name": "beeswax-glasses",
  "private": true,
  "scripts": {
    "dev": "mentra-miniapp dev",
    "build": "bun run build.ts",
    "typecheck": "bun scripts/ensure-config.ts && tsc --noEmit",
    "test": "bun scripts/ensure-config.ts && bun test",
    "release": "mentra-miniapp release",
    "pack": "mentra-miniapp pack",
    "lines": "cp ../hive/out/glasses/lines.generated.ts src/background/lines.generated.ts"
  },
  "dependencies": {
    "@mentra/miniapp": "3.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@mentra/miniapp-cli": "0.1.0-beta.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0"
  }
}
